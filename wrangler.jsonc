// Cloudflare Workers config for OpenNext, deployed into the LaCodea account
// with `npm run deploy` (wrangler login in ~/.config/wrangler-lacodea).
//
// main/assets/compatibility_date are emitted by `opennextjs-cloudflare build`.
// Don't hand-edit the generated .open-next/ directory.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "what-the-index",
  "account_id": "bce226b7fabdb3fc98d2ef6b1f93b036",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // No "limits.cpu_ms": the LaCodea account is on Workers Paid, where the
  // default limit applies. Compare embeds all 31 series and needs a few
  // hundred ms; the Free plan's fixed 10ms answered it with error 1102.
  // Secrets live in the dashboard (wrangler secret put ...) — keeping the
  // list here as documentation. Add NEXT_PUBLIC_SITE_URL etc. via plain
  // vars since they need to be inlined at build time.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://whattheindex.com"
  }
}
